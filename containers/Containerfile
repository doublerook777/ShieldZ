# One image, two commands: `api` and `explainer` (docs/ARCHITECTURE.md §2).
# Built on the VM only (make z-build). Not yet built: the first build is part of the M3 gate.
FROM registry.linuxone.cloud.marist.edu/l1cc/jupyterlab-image-s390x:latest

USER root
WORKDIR /app
COPY requirements/ requirements/
# xgboost, numpy, pandas, scikit-learn, httpx and llama_cpp are already in /opt/venv.
RUN /opt/venv/bin/pip install --no-cache-dir -r requirements/z-extra.txt

# cryptography has no s390x wheel (M0 spike, ADR D6). Ubuntu's apt package works; expose it to the
# venv through a .pth file, which appends the system dist-packages AFTER the venv, so the venv's
# own numpy/xgboost still win. The build fails here if Ed25519 doesn't work, instead of silently
# falling back to the slow pure-Python signer.
RUN if command -v dnf >/dev/null 2>&1; then \
        dnf install -y python3-cryptography && \
        echo /usr/lib64/python3.12/site-packages > "$(/opt/venv/bin/python -c 'import site; print(site.getsitepackages()[0])')/system-dist-packages.pth"; \
    elif command -v apt-get >/dev/null 2>&1; then \
        apt-get update && apt-get install -y --no-install-recommends python3-cryptography && \
        echo /usr/lib/python3/dist-packages > "$(/opt/venv/bin/python -c 'import site; print(site.getsitepackages()[0])')/system-dist-packages.pth"; \
    else echo "no dnf or apt-get: cannot install python3-cryptography" >&2; exit 1; \
    fi \
    && /opt/venv/bin/python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K; K.generate().sign(b'x')"

COPY pyproject.toml pytest.ini ./
COPY src/ src/
COPY scripts/ scripts/
COPY tests/ tests/
COPY containers/entrypoint.sh /usr/local/bin/shieldz-entrypoint
RUN chmod +x /usr/local/bin/shieldz-entrypoint \
    && mkdir -p artifacts results \
    && chown -R 1000:1000 /app

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1

USER 1000
ENTRYPOINT ["shieldz-entrypoint"]
CMD ["api"]
